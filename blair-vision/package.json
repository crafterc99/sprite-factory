{
  "name": "blair-vision",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven AI perception HUD for practice quizzes, studying and accessibility, powered by Jev.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "vitest run",
    "verify": "node scripts/verify-manifest.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify",
    "demo": "node scripts/dev-server.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
