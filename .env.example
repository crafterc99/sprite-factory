# Sprite Factory — environment variables
#
# Local dev: copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `server.js` loads `.env` at startup (zero-dep loader). The file is gitignored.
#
# Railway: set each of these in the Railway dashboard
#   (your service → Variables → New Variable). Redeploy after saving.

# ─── REQUIRED FOR DATA PERSISTENCE (Cloudflare R2) ──────────────────────────
# Without these, the studio still runs, but every character / animation /
# wardrobe write is local-only and will be lost on the next Railway redeploy.
# The red "DATA PERSISTENCE BROKEN" banner shows when any of the three core
# vars (R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) are missing.
#
# Setup (one-time):
#   1. Cloudflare dashboard → R2 → Create bucket.
#      Default name expected by the code is "sprite-factory" (set
#      R2_BUCKET below if you used a different name).
#   2. R2 → Manage R2 API Tokens → Create API Token.
#      Permissions: Object Read & Write. Scope: this bucket only.
#      Save the Access Key ID and Secret Access Key it generates — Cloudflare
#      will not show the secret again.
#   3. Account ID is shown on the R2 overview page (and at the top right of
#      the Cloudflare dashboard).

# R2 S3-compatible endpoint. Format:
#   https://<account-id>.r2.cloudflarestorage.com   (no trailing slash, no bucket in path)
R2_ENDPOINT=

# R2 API token access key.
R2_ACCESS_KEY_ID=

# R2 API token secret.
R2_SECRET_ACCESS_KEY=

# Bucket name. Optional — defaults to "sprite-factory" if unset.
R2_BUCKET=sprite-factory

# Optional: public hostname for the bucket (e.g. https://pub-<hash>.r2.dev or
# a custom domain). Only needed if you want browsers to read R2 objects
# directly. The app proxies all assets through /assets/ served by the Node
# process, so leaving this blank is fine.
# R2_PUBLIC_URL=

# ─── LEGACY / FALLBACK (Supabase) ───────────────────────────────────────────
# The previous storage backend. Still supported via lib/supabase-storage.js's
# routing fallback for old deploys that haven't switched yet. Leave blank
# if you're using R2 (the recommended setup).
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# ─── REQUIRED FOR GENERATION ────────────────────────────────────────────────
# Google AI Studio key for Nano Banana / Gemini image models.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── OPTIONAL ───────────────────────────────────────────────────────────────
# Override the listen port. Railway sets this via railway.json startCommand
# (PORT=3456). Locally, leave it unset to default to 3456.
# PORT=3456
